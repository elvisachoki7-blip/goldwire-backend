# Server
PORT=4000
JWT_SECRET=replace-with-a-long-random-string

# Admin panel password (used to log into /admin.html)
ADMIN_PASSWORD=replace-with-a-strong-password

# MT5 EA webhook — set this same value in your EA's HTTP request header
# "x-webhook-secret" when calling POST /api/signals/webhook
MT5_WEBHOOK_SECRET=replace-with-a-long-random-string

# Email (SMTP) — works with Gmail, Resend, SendGrid, Mailgun, etc.
# Leave blank to run without sending real emails (they'll just log to console).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="GOLDWIRE Signals" <signals@yourdomain.com>
